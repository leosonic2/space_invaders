{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}\\build",
        "-G",
        "Ninja",
        "-DCMAKE_C_COMPILER=C:\\msys64\\ucrt64\\bin\\gcc.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}\\build",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      },
      "dependsOn": "CMake: configure",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
